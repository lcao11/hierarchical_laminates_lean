module

public import HierarchicalLaminates.TwoWell.Minorant
public import HierarchicalLaminates.TwoWell.MinorantRegularity
public import HierarchicalLaminates.TwoWell.WellProperties
public import HierarchicalLaminates.TwoWell.EnvelopeProperties
public import HierarchicalLaminates.TwoWell.PeriodicTrials

/-!
# Comparing the quasiconvex and rank-one convex envelopes

For the same binary arrangement, the two cell problems supply an upper
bound at the paired mean gradient. The compact-family minorant supplies
the lower bound. Their difference is exactly the composite's
loading-energy difference.

The final step chooses a half-fraction binary seed with a positive loading
difference. The constituents and mean loadings are explicit construction data.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

namespace HierarchicalLaminates.TwoWell

open MeasureTheory Matrix HierarchicalLaminates HierarchicalLaminates.Periodic
  HierarchicalLaminates.Material HierarchicalLaminates.Lamination

/-- Mean flux generated by the second selected loading in the chosen arrangement. -/
def applicationFlux (b : PhaseFraction) : Gradient16 := effectiveMatrix b *ᵥ etaFlat

/-- The paired mean gradient used to detect the envelope gap. -/
def applicationMean (b : PhaseFraction) : PairedGradient :=
  (xiFlat, rotate (applicationFlux b))

/-- Testing both quadratic blocks in the same binary arrangement gives the upper bound. -/
theorem quasiconvex_upper (b : PhaseFraction)
    (hb : ∀ q, b.value q = 0 ∨ b.value q = 1) :
    quasiconvexEnvelope twoWellEnergy (applicationMean b) ≤
      quadraticEnergy (effectiveMatrix b) xiFlat +
        quadraticEnergy (effectiveMatrix b) etaFlat := by
  apply quasiconvexEnvelope_le twoWellEnergy_nonneg
  intro h hh
  exact periodic_minorant_upper b hb h hh.1 hh.2
    (WithLp.toLp 2 xiFlat) (WithLp.toLp 2 etaFlat)

/-- The family equality gives a lower bound at every prescribed mean flux. -/
theorem rankOne_lower (p : Gradient16) :
    2 * (etaFlat ⬝ᵥ p) ≤ rankOneEnvelope twoWellEnergy (xiFlat, rotate p) :=
  (minorant_lower_bound p).trans
    (le_rankOneEnvelope minorant_rankOneConvex minorant_le_twoWellEnergy _)

/-- The two cell energies differ from the lower bound by the detected loading difference. -/
theorem application_energy_identity (b : PhaseFraction) :
    quadraticEnergy (effectiveMatrix b) xiFlat +
        quadraticEnergy (effectiveMatrix b) etaFlat =
      2 * (etaFlat ⬝ᵥ applicationFlux b) - physicalLoadingDifference b := by
  unfold applicationFlux physicalLoadingDifference loadingDifference quadraticEnergy
  ring

/-- The composite's loading difference is a quantitative lower bound for the envelope gap. -/
theorem quantitative_gap (b : PhaseFraction)
    (hb : ∀ q, b.value q = 0 ∨ b.value q = 1) :
    physicalLoadingDifference b ≤
      rankOneEnvelope twoWellEnergy (applicationMean b) -
        quasiconvexEnvelope twoWellEnergy (applicationMean b) := by
  have hupper := quasiconvex_upper b hb
  rw [application_energy_identity] at hupper
  have hlower := rankOne_lower (applicationFlux b)
  change 2 * (etaFlat ⬝ᵥ applicationFlux b) ≤
    rankOneEnvelope twoWellEnergy (applicationMean b) at hlower
  linarith

/-- A positive composite loading difference gives strict separation of the envelopes. -/
theorem strict_gap (b : PhaseFraction)
    (hb : ∀ q, b.value q = 0 ∨ b.value q = 1)
    (hgap : 0 < physicalLoadingDifference b) :
    quasiconvexEnvelope twoWellEnergy (applicationMean b) <
      rankOneEnvelope twoWellEnergy (applicationMean b) :=
  sub_pos.mp (hgap.trans_le (quantitative_gap b hb))

/-- A binary seed with a positive loading difference gives strict and quantitative separation. -/
theorem two_well_gap : ∃ N : ℕ, 2 ≤ N ∧
    (∀ q, (binaryFraction N).value q = 0 ∨ (binaryFraction N).value q = 1) ∧
    (∫ q, (binaryFraction N).value q ∂domainMeasure) = 1 / 2 ∧
    0 < physicalLoadingDifference (binaryFraction N) ∧
    quasiconvexEnvelope twoWellEnergy (applicationMean (binaryFraction N)) <
      rankOneEnvelope twoWellEnergy (applicationMean (binaryFraction N)) ∧
    physicalLoadingDifference (binaryFraction N) ≤
      rankOneEnvelope twoWellEnergy (applicationMean (binaryFraction N)) -
        quasiconvexEnvelope twoWellEnergy (applicationMean (binaryFraction N)) := by
  obtain ⟨N, hN, hbinary, hmean, _henergy, hgap, _hexclusion⟩ :=
    half_fraction_counterexample
  exact ⟨N, hN, hbinary, hmean, hgap,
    strict_gap _ hbinary hgap, quantitative_gap _ hbinary⟩

end HierarchicalLaminates.TwoWell
